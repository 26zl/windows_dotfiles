root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.theme]
end_of_line = crlf

# Windows Terminal rewrites this file through the symlink, without a final newline.
[terminal/settings.json]
insert_final_newline = false
