// fastfetch configuration - Nord-ish, compact, nothing that leaks addresses in a screenshot.
// Reference: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "windows_11_small",
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "blue", "title": "cyan" },
        "key": { "width": 10 }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "OS" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Packages" },
        { "type": "shell", "key": "Shell" },
        { "type": "display", "key": "Display", "compactType": "original-with-refresh-rate" },
        { "type": "wm", "key": "WM" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "terminalfont", "key": "Font" },
        { "type": "cpu", "key": "CPU" },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "Memory" },
        { "type": "disk", "key": "Disk" },
        "break",
        "colors"
    ]
}
